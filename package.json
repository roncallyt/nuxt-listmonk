{
  "name": "nuxt-listmonk",
  "version": "3.0.0",
  "description": "Listmonk module for nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roncallyt/nuxt-listmonk.git"
  },
  "homepage": "https://nuxt-listmonk.t7n.dev",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint eslint.config.mjs src playground test docs/app docs/nuxt.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p playground/tsconfig.json",
    "changelog": "changelogen",
    "release:prepare": "changelogen --bump",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "^24.13.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
